{
  "name": "dsh-sla",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "从一句目标开始，自主建立依据并持续探索项目改进。",
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./src/host.js",
    "./tools": "./src/tools.js",
    "./performance": "./extensions/performance.js",
    "./bugfix": "./extensions/bugfix.js",
    "./extension": {
      "types": "./src/extension.d.ts",
      "default": "./src/evaluation.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "extensions",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs",
    "examples",
    "scripts",
    "test"
  ],
  "scripts": {
    "test": "node --test test/*.test.js examples/*/*.test.js",
    "check": "node scripts/check.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
