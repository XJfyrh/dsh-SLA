{
  "name": "dsh-sla",
  "version": "0.4.0",
  "type": "module",
  "description": "从一句目标开始，自主建立依据并持续探索项目改进。",
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": {
      "types": "./dist/src/host.d.ts",
      "default": "./dist/src/host.js"
    },
    "./tools": {
      "types": "./dist/src/tools.d.ts",
      "default": "./dist/src/tools.js"
    },
    "./performance": {
      "types": "./dist/extensions/performance.d.ts",
      "default": "./dist/extensions/performance.js"
    },
    "./bugfix": {
      "types": "./dist/extensions/bugfix.d.ts",
      "default": "./dist/extensions/bugfix.js"
    },
    "./parameters": {
      "types": "./dist/extensions/parameters.d.ts",
      "default": "./dist/extensions/parameters.js"
    },
    "./workflow": {
      "types": "./dist/src/workflow.d.ts",
      "default": "./dist/src/workflow.js"
    },
    "./client": {
      "types": "./dist/src/client-factory.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "tsc --noEmit -p tsconfig.client.json && node scripts/build-client.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc -p tsconfig.consumer.json && tsc -p tsconfig.client-consumer.json",
    "check": "node scripts/check.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js examples/*/*.test.js",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "author": "XJfyrh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XJfyrh/dsh-SLA.git"
  },
  "homepage": "https://github.com/XJfyrh/dsh-SLA#readme",
  "bugs": {
    "url": "https://github.com/XJfyrh/dsh-SLA/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "stateless-language-agents",
    "sla"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "lexical": "0.49.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  }
}
