{
  "name": "dsh-sla",
  "version": "0.4.0",
  "type": "module",
  "description": "从一句目标开始，自主建立依据并持续探索项目改进。",
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./src/host.js",
    "./tools": "./src/tools.js",
    "./performance": "./extensions/performance.js",
    "./bugfix": "./extensions/bugfix.js",
    "./parameters": "./extensions/parameters.js",
    "./workflow": {
      "types": "./src/workflow.d.ts",
      "default": "./src/workflow.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "extensions",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "test": "node --test test/*.test.js examples/*/*.test.js",
    "check": "node scripts/check.mjs",
    "check:types": "tsc --noEmit --strict --module NodeNext --target ES2022 test/workflow-types.ts",
    "build:client": "node scripts/build-client.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "author": "XJfyrh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XJfyrh/dsh-SLA.git"
  },
  "homepage": "https://github.com/XJfyrh/dsh-SLA#readme",
  "bugs": {
    "url": "https://github.com/XJfyrh/dsh-SLA/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "stateless-language-agents",
    "sla"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "typescript": "5.9.3"
  }
}
